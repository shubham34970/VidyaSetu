# VidyaSetu — Environment Configuration Template
# Copy this file to .env or backend/.env and update values. Never commit .env!

# ==========================================
# TinyFish Integration
# ==========================================
# Optional: TinyFish API Key for real-time live portal navigation and web extraction.
# If omitted or invalid, VidyaSetu gracefully uses verified cached government schemes.
TINYFISH_API_KEY=your_tinyfish_api_key_here

# ==========================================
# Backend Server Configuration
# ==========================================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# Cache & Rate Limiting
# ==========================================
# Time to live in seconds for cached portal scraping results (default: 24h = 86400s)
CACHE_TTL_SECONDS=86400

# ==========================================
# Frontend Configuration
# ==========================================
VITE_API_BASE_URL=http://127.0.0.1:8000/api
